# Copy to .env locally (never commit real secrets).
# On Cloud Run, you can set the same names as service env vars; server.js serves
# /runtime-config.js so Google sign-in works without build-time env (see GOOGLE_CLIENT_ID).

REACT_APP_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
REACT_APP_VERTEX_API_KEY=
